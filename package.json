{
  "name": "club-racing-festival",
  "private": true,
  "version": "1.0.0",
  "description": "文化祭用 ブラウザ3Dローポリカーレースゲーム (完全オフライン動作)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --port 4173",
    "festival": "tsc --noEmit && vite build --mode festival && vite preview --mode festival --port 4173 --open",
    "festival:serve": "vite preview --mode festival --port 4173 --open",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:courses": "vite-node scripts/check-courses.ts",
    "sim": "vite-node scripts/sim-race.ts",
    "check:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
